# =========================================
# Configuration Supabase pour RAG Agent
# Copier ce fichier vers .env et remplir les valeurs
# =========================================

# Supabase Configuration
# Obtenir ces valeurs depuis: https://supabase.com/dashboard/project/[votre-project]/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGc...[votre-anon-key]
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...[votre-service-role-key]

# Database URL PostgreSQL
# Obtenir depuis: https://supabase.com/dashboard/project/[votre-project]/settings/database
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Tables PostgreSQL
POSTGRES_TABLE_DOCUMENTS=documents
POSTGRES_TABLE_CHUNKS=chunks

# LLM Provider Configuration - RODIUMAI (gateway compatible OpenAI)
# Clé à créer sur https://www.rodiumai.io/dashboard/api-keys (format rd_sk_...)
# Modèles : IDs préfixés par le fournisseur (voir GET https://api.rodiumai.io/v1/models).
# Ex. openai/gpt-5-mini, anthropic/claude-sonnet-5, deepseek/deepseek-v3.2, rodiumai/smart.
LLM_PROVIDER=openai
LLM_API_KEY=rd_sk_REMPLACER_PAR_TA_CLE_RODIUMAI
LLM_MODEL=openai/gpt-5-mini
LLM_BASE_URL=https://api.rodiumai.io/v1

# LLM Generation Parameters (pour réduire les hallucinations)
# Temperature: 0.0-1.0 (plus bas = plus déterministe, moins d'hallucinations)
LLM_TEMPERATURE=0.1
# Top-p: nucleus sampling (0.9 = bon équilibre)
LLM_TOP_P=0.9
# Max tokens: limite la longueur des réponses
LLM_MAX_TOKENS=4000

# Embedding Provider Configuration - RODIUMAI (même clé)
# openai/text-embedding-3-small => 1536 dims (doit correspondre à vector(N) en base)
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=rd_sk_REMPLACER_PAR_TA_CLE_RODIUMAI
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_BASE_URL=https://api.rodiumai.io/v1
EMBEDDING_DIMENSION=1536

# Search Configuration
DEFAULT_MATCH_COUNT=10
MAX_MATCH_COUNT=50
DEFAULT_TEXT_WEIGHT=0.3

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO

# =========================================
# INSTRUCTIONS:
# =========================================
#
# 1. Créer un projet Supabase sur https://supabase.com
#
# 2. Obtenir SUPABASE_URL et les clés API:
#    - Aller dans: Project Settings > API
#    - Copier "Project URL" → SUPABASE_URL
#    - Copier "anon public" → SUPABASE_ANON_KEY
#    - Copier "service_role" → SUPABASE_SERVICE_ROLE_KEY
#
# 3. Obtenir DATABASE_URL:
#    - Aller dans: Project Settings > Database
#    - Section "Connection string" > "URI"
#    - Choisir "Session pooler" ou "Direct connection"
#    - Copier l'URL et remplacer [YOUR-PASSWORD] par votre mot de passe
#
# 4. Créer le schéma (tables cagecfi_*):
#    - SQL Editor: coller le contenu de supabase_setup_cagecfi.sql, ou
#    - exécuter: uv run python apply_supabase_setup.py
#
# 5. Vérifier que pgvector est activé:
#    SELECT * FROM pg_extension WHERE extname = 'vector';
#
# 6. Renommer ce fichier en .env et remplir vos valeurs
#
# 7. Installer les dépendances:
#    uv pip install asyncpg pgvector supabase
#
# 8. Lancer l'ingestion:
#    uv run python -m src.ingestion.ingest_supabase -d ./documents
#
# 9. Lancer l'application:
#    uv run python -m streamlit run src/streamlit_app_supabase.py
#
# =========================================
