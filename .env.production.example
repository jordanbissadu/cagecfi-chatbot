# =========================================
# Configuration PRODUCTION (cloud) — pour Vercel
# =========================================
# Ces valeurs sont à saisir dans Vercel :
#   Project Settings → Environment Variables (PAS dans un fichier .env déployé).
# Ce fichier sert aussi à l'INGESTION locale en mode cloud : copier en .env,
# remplir, puis relancer l'ingestion pour produire des embeddings 1536 dim.
# =========================================

# --- Supabase ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# DATABASE_URL : EN SERVERLESS, UTILISER LE POOLER "TRANSACTION" (port 6543).
# Dashboard → Project Settings → Database → Connection string → "Transaction pooler".
# Le code force déjà statement_cache_size=0 (compatible pgbouncer).
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Tables
POSTGRES_TABLE_DOCUMENTS=cagecfi_documents
POSTGRES_TABLE_CHUNKS=cagecfi_chunks

# --- LLM : OpenAI ---
# Clé : https://platform.openai.com/api-keys (une seule clé pour LLM + embeddings)
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9
LLM_MAX_TOKENS=1024

# --- Embeddings : OpenAI (même clé) ---
# text-embedding-3-small => 1536 dimensions (doit matcher le schéma SQL).
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIMENSION=1536

# --- Recherche ---
DEFAULT_MATCH_COUNT=10
MAX_MATCH_COUNT=50
DEFAULT_TEXT_WEIGHT=0.3

# --- Divers ---
APP_ENV=production
LOG_LEVEL=INFO
# Laisser à 0 en serverless (Vercel). Mettre 1 seulement sur un serveur persistant.
ENABLE_WARMUP=0
